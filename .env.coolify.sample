# Copy these entries into the ignored .env; never commit real values.
COOLIFY_BASE_URL=https://coolify.fastsme.com
COOLIFY_API_TOKEN=
XAI_API_KEY=
FASTCLINIC_API_PUBLIC_URL=https://api.fastclinic.dev

# Market collection and encrypted search keys.
EXA_API_KEY=
MARKET_CREDENTIALS_KEY=
FASTCLINIC_MARKET_WORKER_ENABLED=true

# Persist the included AI/BYOK integration outside the container image.
BYOK_DB=/data/byok.sqlite
BYOK_ENCRYPTION_KEY=
