# --- FastClinic Cockpit ---

FASTCLINIC_SECRET=change-me-to-a-long-random-hex
FASTCLINIC_PORT=5005
FASTCLINIC_ENV_LABEL=FastClinic
# Comma-separated immutable bootstrap administrators. These are merged with
# FastClinic's three built-in project administrators and the legacy singular
# FASTCLINIC_ADMIN_EMAIL when present.
FASTCLINIC_ADMIN_EMAILS=kaljuvee@gmail.com,joosep.laats@gmail.com,patrickh217@gmail.com,phil.hermann217@gmail.com

# Optional local/demo bootstrap account. It is inserted into the same account
# store and uses the same /auth/local/login flow as every other user. Keep this
# disabled in production; there are no built-in credentials.
FASTCLINIC_BOOTSTRAP_AUTH_ENABLED=false
FASTCLINIC_BOOTSTRAP_EMAIL=
FASTCLINIC_BOOTSTRAP_PASSWORD=

# Clinical database backend: sqlite (default/local) or postgresql.
FASTCLINIC_DATABASE_BACKEND=postgresql
FASTCLINIC_OPS_BACKEND=postgresql

# SQLite clinical database (built by: python -m pms.importer).
# In Docker mount a volume and point here, e.g. /data/fastclinic.sqlite.
FASTCLINIC_DB=

# PostgreSQL clinical database. Production uses DATABASE_URL_PROD; DATABASE_URL
# is accepted as a fallback. FastClinic is isolated to this schema.
DATABASE_URL_PROD=
FASTCLINIC_DB_SCHEMA=fast_clinic

# Optional: pin the "today" reference date for due/lapsed maths (YYYY-MM-DD).
# Leave blank to use the latest activity date in the data.
FASTCLINIC_TODAY=

# AI assistant (free-form chat) — LangGraph agent with a configurable provider.
# Without a provider/key, slash-commands still work and chat shows a fallback.
#   MODEL_PROVIDER: xai | openai | anthropic | google
#   MODEL_NAME:     e.g. grok-4-1-fast-reasoning, gpt-4o-mini, claude-3-5-sonnet-latest
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# DeepEval LLM judge — selected independently from the assistant above.
# These may point at the same provider/model, but must be explicit so model
# comparisons cannot silently change the judge. Uses the matching API key above.
EVAL_LLM_PROVIDER=xai
EVAL_LLM_MODEL=grok-4-1-fast-reasoning
EVAL_LLM_TIMEOUT=90

# Persistent conversation memory (stored in FASTCLINIC_OPS_DB).
# Model replay is the most recent 20 messages / 24k characters. Up to 100
# messages per thread are retained for 30 days; each stored message is capped.
FASTCLINIC_CHAT_HISTORY_MESSAGES=20
FASTCLINIC_CHAT_HISTORY_CHARS=24000
FASTCLINIC_CHAT_STORED_MESSAGES=100
FASTCLINIC_CHAT_MESSAGE_CHARS=12000
FASTCLINIC_CHAT_RETENTION_DAYS=30

# SEO audit module — site to audit
FASTCLINIC_SEO_SITE=https://fastclinic.dev

# SMS providers (for outbound campaigns; optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VOODOO_SMS_API_KEY=
VOODOO_SMS_FROM=

# Email provider (Postmark; optional)
POSTMARK_API_TOKEN=
POSTMARK_FROM=
EMAIL_REPLY_TO=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fastclinic.dev/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://fastclinic.dev
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public synthetic clinical/aggregate reads need no credential. Operational
# reads and every mutation require this bearer token; leave blank to disable
# those routes with HTTP 503.
FASTSME_API_TOKEN=

# Separate least-privilege token for the FastBooking availability/reservation
# bridge. It cannot read clinical, billing, activation, or communication data.
FASTBOOKING_API_TOKEN=

# MedBackend — configurable primary FHIR/auth record.
# Keep disabled until OAuth client secrets and FastClinic callback URIs are
# configured in both MedBackend and this deployment.
MEDBACKEND_ENABLED=false
MEDBACKEND_RECORD_MODE=mirror
MEDBACKEND_SYNC_MODE=dry_run
MEDBACKEND_PROJECT_ID=c82bf761-d720-4eb8-92e7-3719da7342fd
MEDBACKEND_GRAPHQL_URL=https://dev-backbone.medbackend.com/graphql
MEDBACKEND_REST_URL=https://dev-backbone.medbackend.com
MEDBACKEND_PATIENT_CLIENT_ID=medbackend_c82bf761_patient
MEDBACKEND_PATIENT_CLIENT_SECRET=
MEDBACKEND_PATIENT_AUTH_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/patient/authorize
MEDBACKEND_PATIENT_TOKEN_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/patient/token
MEDBACKEND_PATIENT_JWKS_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/patient/.well-known/jwks.json
MEDBACKEND_PATIENT_REDIRECT_URI=https://fastclinic.dev/integrations/medbackend/patient/callback
MEDBACKEND_PATIENT_SCOPES="openid profile patient/*.read"
MEDBACKEND_OAUTH_TEST_EMAIL=kaljuvee@gmail.com
MEDBACKEND_PATIENT_REDIRECT_URI=
MEDBACKEND_PRACTITIONER_CLIENT_ID=medbackend_c82bf761_practitioner
MEDBACKEND_PRACTITIONER_CLIENT_SECRET=
MEDBACKEND_PRACTITIONER_AUTH_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/practitioner/authorize
MEDBACKEND_PRACTITIONER_TOKEN_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/practitioner/token
MEDBACKEND_PRACTITIONER_JWKS_URL=https://dev-auth.medbackend.com/oauth/c82bf761-d720-4eb8-92e7-3719da7342fd/practitioner/.well-known/jwks.json
MEDBACKEND_PRACTITIONER_REDIRECT_URI=
MEDBACKEND_WEBHOOK_SECRET=
MEDBACKEND_TIMEOUT_SECONDS=30
MEDBACKEND_MAX_RETRIES=3

# NHS / GP Connect live spine — leave disabled. Mapping, NHS Number check-digit,
# UK Core R4 export and GP Connect STU3 translation work offline without these.
# Live PDS / GP Connect raise AdapterNotAvailable until onboarding completes.
NHS_LIVE_ENABLED=false
NHS_PDS_BASE_URL=
NHS_PDS_API_KEY=
NHS_GPCONNECT_ENDPOINT=
NHS_GPCONNECT_FROM_ASID=
NHS_GPCONNECT_TO_ASID=

# Lithuania / E. sveikata (ESPBI IS). Synthetic mappings and the local mock
# exchange ledger work without configuration. Live calls remain hard-disabled
# until Registru centras onboarding, official test acceptance, current profile
# pinning, and an approved qualified-signature provider are complete.
LT_ESPBI_LIVE_ENABLED=false
LT_ESPBI_BASE_URL=
LT_ESPBI_CONSUMER_KEY=
LT_ESPBI_PRIVATE_KEY_FILE=
LT_ESPBI_ORGANIZATION_JAR=
LT_ESPBI_SPEC_VERSION=

# Estonia / TEHIK TIS over X-Road. Sandbox CDA/MPI projections work offline.
# Production requires the clinic's registered X-Road subsystem and TEHIK-granted
# service access; the application must never connect as a generic vendor tenant.
EE_TIS_LIVE_ENABLED=false
EE_XROAD_SECURITY_SERVER=
EE_XROAD_INSTANCE=ee-dev
EE_XROAD_CLIENT=
EE_TIS_ORGANIZATION_CODE=
EE_TIS_PROFILE_VERSION=
